# Copiar a .env y completar SOLO lo del proveedor elegido.
# Proveedor del LLM bajo prueba: mock | anthropic | openai | ollama
LLM_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (modelo local gratuito)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# URL de Ollama vista desde los contenedores de docker compose
# ("localhost" dentro de un contenedor es el propio contenedor)
OLLAMA_URL_DOCKER=http://host.docker.internal:11434

# Límites de la llamada al LLM (sobrescriben config/settings.yaml).
# Con modelos locales en CPU subir el timeout: la primera llamada carga el modelo.
# LLM_TIMEOUT_S=600
# LLM_MAX_TOKENS=300

# Latencia simulada del mock (ms), útil para demostrar la métrica de latencia
MOCK_LATENCY_MS=0
